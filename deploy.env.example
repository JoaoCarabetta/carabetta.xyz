# Copy to deploy.env and fill in your VPS details.
# GitHub Actions uses secrets VPS_HOST / VPS_USER / VPS_SSH_KEY instead
# (VPS_HOST must be the public IP, not this SSH config alias).
SSH_HOST=hetzner-arv-public
SSH_USER=root
REMOTE_PATH=/var/www/carabetta.xyz

# Use "nginx" on a VPS that already serves other sites on ports 80/443.
# Use "caddy" on a clean VPS dedicated to this site.
WEB_SERVER=nginx
NGINX_SITE_NAME=carabetta.xyz

# Only used when WEB_SERVER=caddy
CADDYFILE_PATH=/etc/caddy/Caddyfile

# Password protection for /transparencia/ (HTTP basic auth; browser keeps credentials for the session)
TRANSPARENCIA_AUTH_USER=transparencia
TRANSPARENCIA_AUTH_PASSWORD=change-me
