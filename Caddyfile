carabetta.xyz, www.carabetta.xyz {
    root * /var/www/carabetta.xyz
	encode gzip {
		not path *.pbf *.pmtiles
	}

	import transparencia-auth.caddy

	# Old map slug → /dotsbr, keeping the rest of the path.
	@old_dots path_regexp olddots ^/dataviz/brazildots(.*)$
	redir @old_dots /dotsbr{re.olddots.1} permanent

	file_server

    @www host www.carabetta.xyz
    redir @www https://carabetta.xyz{uri} permanent
}
